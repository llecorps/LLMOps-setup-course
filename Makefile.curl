# =============================================================================
# Core API Testing with Caching and MLflow Tracing
# =============================================================================

# -----------------------------------------------------------------------------
# LEGITIMATE REQUESTS (Baseline)
# -----------------------------------------------------------------------------

test-api-legit:
	@echo "🔍 Testing legitimate API request..."
	@TOKEN=$$(curl -s -X POST http://localhost:8000/auth/login \
		-H "Content-Type: application/json" \
		-d '{"username": "admin", "password": "secret123"}' \
		| jq -r '.access_token'); \
	curl -X POST http://localhost:8000/llm/generate \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d '{"model": "groq-kimi-primary", "prompt": "What are best practices for secure API design?", "max_tokens": 100}' \
		| jq -C '.'

test-api-semantic:
	@echo "🔍 Testing semantic variation..."
	@TOKEN=$$(curl -s -X POST http://localhost:8000/auth/login \
		-H "Content-Type: application/json" \
		-d '{"username": "admin", "password": "secret123"}' \
		| jq -r '.access_token'); \
	curl -X POST http://localhost:8000/llm/generate \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d '{"model": "groq-kimi-primary", "prompt": "Could you share guidelines for creating a secure API?", "max_tokens": 100}' \
		| jq -C '.'

test-api-semantic-2:
	@echo "🔍 Testing true semantic caching (different words, same meaning)..."
	@TOKEN=$$(curl -s -X POST http://localhost:8000/auth/login \
		-H "Content-Type: application/json" \
		-d '{"username": "admin", "password": "secret123"}' \
		| jq -r '.access_token'); \
	curl -X POST http://localhost:8000/llm/generate \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d '{"model": "groq-kimi-primary", "prompt": "How do I build a safe REST API?", "max_tokens": 100}' \
		| jq -C '.'

# -----------------------------------------------------------------------------
# HELP
# -----------------------------------------------------------------------------

test-api-semantic-3:
	@echo "🔍 Testing semantic cache with new prompt (3/4)..."
	@TOKEN=$$(curl -s -X POST http://localhost:8000/auth/login \
		-H "Content-Type: application/json" \
		-d '{"username": "admin", "password": "secret123"}' \
		| jq -r '.access_token'); \
	curl -X POST http://localhost:8000/llm/generate \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d '{"model": "groq-kimi-primary", "prompt": "Peux-tu me faire un résumé de l'\''intrigue du film Inception ?", "max_tokens": 150}' \
		| jq -C '.'

test-api-semantic-4:
	@echo "🔍 Testing semantic cache with similar prompt (4/4)..."
	@TOKEN=$$(curl -s -X POST http://localhost:8000/auth/login \
		-H "Content-Type: application/json" \
		-d '{"username": "admin", "password": "secret123"}' \
		| jq -r '.access_token'); \
	curl -X POST http://localhost:8000/llm/generate \
		-H "Content-Type: application/json" \
		-H "Authorization: Bearer $$TOKEN" \
		-d '{"model": "groq-kimi-primary", "prompt": "Fais un bref synopsis du film Inception de Christopher Nolan.", "max_tokens": 150}' \
		| jq -C '.'

# -----------------------------------------------------------------------------
# HELP
# -----------------------------------------------------------------------------

help:
	@echo "API Testing Commands:"
	@echo ""
	@echo "Core Testing:"
	@echo "  test-api-legit           - Test API request with caching and MLflow tracing"
